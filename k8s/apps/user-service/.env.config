APP_NAME=UserService
APP_ENV=production
APP_DEBUG=false

# 1. Laravel connects to the sidecar container locally
DB_HOST=127.0.0.1
DB_PORT=3306

# 2. The sidecar uses this to find the actual Cloud SQL instance
# Format: project-id:region:instance-name
CLOUD_SQL_CONNECTION_NAME=your-gcp-project:asia-southeast1:production-db