apiVersion: apps/v1
kind: Deployment
metadata:
  name: user-service
spec:
  replicas: 2
  selector:
    matchLabels:
      app: user-service
  template:
    metadata:
      labels:
        app: user-service
    spec:
      containers:
      - name: user-service
        image: asia-southeast1-docker.pkg.dev/project-501674b6-7d67-40dc-99c/laravel-microservices-repo/user-service:v1.0.0
        ports:
        - containerPort: 80
        
        envFrom:
        - configMapRef:
            name: laravel-config
        - secretRef:
            name: laravel-secrets
            
        volumeMounts:
        - name: passport-keys-volume
          mountPath: /var/www/html/storage/oauth-private.key
          subPath: oauth-private.key
          readOnly: true
        - name: passport-keys-volume
          mountPath: /var/www/html/storage/oauth-public.key
          subPath: oauth-public.key
          readOnly: true
          
      volumes:
      - name: passport-keys-volume
        secret:
          secretName: passport-keys

---
apiVersion: v1
kind: Service
metadata:
  name: user-service-internal
spec:
  selector:
    app: user-service
  ports:
    - protocol: TCP
      port: 80
      targetPort: 80
  type: ClusterIP